    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (SELECT id FROM jobs WHERE linkedin_job_id = '{{ $json.linkedin_job_id }}') as existing_id",
        "options": {}
      },
      "id": "check-duplicate",
