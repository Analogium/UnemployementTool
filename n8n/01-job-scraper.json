        "postgres": {
          "id": "POSTGRES_CRED_ID",
          "name": "PostgreSQL linkedin_jobs"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "new-job-check",
              "leftValue": "={{ $json.existing_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "is-new-job",
      "name": "Nouvelle offre ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1340,
        380
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "jobs",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "linkedin_job_id": "={{ $('1 item par offre').item.json.linkedin_job_id }}",
            "title": "={{ $('1 item par offre').item.json.title }}",
            "company": "={{ $('1 item par offre').item.json.company }}",
            "location": "={{ $('1 item par offre').item.json.location }}",
            "job_url": "={{ $('1 item par offre').item.json.job_url }}",
            "apply_type": "={{ $('1 item par offre').item.json.apply_type }}",
            "status": "pending"
          }
        },
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "insert-job",
      "name": "Insérer en DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        280
